# The sample site's response headers (sample/Caddyfile imports them as /etc/webfast/headers.caddy):
# security headers for every response, caching by kind of file, preload hints for the pages — the
# shape a site's build typically generates.
(site_headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU='; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; manifest-src 'self'; worker-src 'self'"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		X-DNS-Prefetch-Control "on"
		-Server
	}
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=31536000, immutable"
	@images path /images/* /favicon.svg /favicon.ico
	header @images Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
	@sw path /sw.js /v.json
	header @sw Cache-Control "max-age=300"
	@html_latin path /en/* /de/* /fr/*
	header @html_latin Cache-Control "public, max-age=0, must-revalidate"
	header @html_latin Link "</assets/main-Sample.css>; rel=preload; as=style, </assets/main-Sample.js>; rel=modulepreload, </fonts/sans-latin.woff2>; rel=preload; as=font; type=\"font/woff2\"; crossorigin, </fonts/display-latin.woff2>; rel=preload; as=font; type=\"font/woff2\"; crossorigin"
	@html_cyrillic path /ru/*
	header @html_cyrillic Cache-Control "public, max-age=0, must-revalidate"
	header @html_cyrillic Link "</assets/main-Sample.css>; rel=preload; as=style, </assets/main-Sample.js>; rel=modulepreload, </fonts/sans-cyrillic.woff2>; rel=preload; as=font; type=\"font/woff2\"; crossorigin"
}
